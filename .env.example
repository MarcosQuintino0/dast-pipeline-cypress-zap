# ---------------------------------------------------------------------------
# Configuracao do pipeline. Copie para .env e ajuste se necessario.
#
# Nenhum valor aqui e segredo. O alvo e o ZAP sobem no seu proprio Docker e nao
# ha credencial de terceiros envolvida em nenhuma parte deste projeto.
# ---------------------------------------------------------------------------

# Alvo do scan: API local com a forma do JSONPlaceholder, subida pelo compose.
TARGET_URL=http://localhost:3000

# Portas publicadas no host. Ajuste se colidirem com algo que ja roda.
API_PORT=3000
ZAP_PORT=8080

# API do OWASP ZAP em modo daemon.
# A chave e local e descartavel: existe para que a API do ZAP nao fique aberta
# a qualquer processo da maquina, e nao para proteger dado sensivel.
ZAP_HOST=127.0.0.1
ZAP_API_KEY=dast-pipeline-local

# Intensidade do scan ativo.
#   ZAP_ATTACK_STRENGTH: LOW | MEDIUM | HIGH | INSANE
#   ZAP_ALERT_THRESHOLD: LOW | MEDIUM | HIGH   (LOW reporta ate suspeita fraca)
ZAP_ATTACK_STRENGTH=MEDIUM
ZAP_ALERT_THRESHOLD=LOW

# Guarda de seguranca: o scan so roda contra hosts desta lista.
# Nunca inclua um dominio que nao seja seu. Scan ativo e ataque de verdade.
ALLOWED_SCAN_HOSTS=localhost,127.0.0.1,api
